---
import { CATEGORIES } from '../lib/categories';

const words = [...Object.values(CATEGORIES).map((c) => c.label), 'Painting', 'Doodles'];
const row = [...words, ...words];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {
      [0, 1].map(() => (
        <span class="marquee__group">
          {row.map((w) => (
            <span class="marquee__item">
              {w} <span class="marquee__spark">✦</span>
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    background: var(--sun);
    border-bottom: 4px solid var(--ink);
    overflow: hidden;
    rotate: -1.5deg;
    margin: -0.8rem -1rem 0;
    position: relative;
    z-index: 2;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 32s linear infinite;
  }

  .marquee__group {
    display: flex;
  }

  .marquee__item {
    padding: 0.9rem 0 0.9rem 1.6rem;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 800;
    text-transform: uppercase;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .marquee__spark {
    color: var(--pink);
    -webkit-text-stroke: 1.5px var(--ink);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
