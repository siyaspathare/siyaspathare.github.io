---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/cv/', label: 'CV' },
];
const path = Astro.url.pathname;
---

<header class="nav">
  <div class="nav__inner wrap">
    <a class="nav__logo" href="/" aria-label="Siya — home">
      <Image src={logo} alt="" width={64} height={64} densities={[1, 2]} loading="eager" />
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-block: 1rem;
    view-transition-name: site-nav;
    pointer-events: none;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav__logo,
  ul {
    pointer-events: auto;
  }

  .nav__logo {
    display: block;
    width: 64px;
    height: 64px;
    border: 3px solid var(--ink);
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 3px 3px 0 var(--ink);
    transition: transform 0.2s;
  }

  .nav__logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nav__logo:hover {
    transform: rotate(-4deg) scale(1.05);
  }

  ul {
    display: flex;
    gap: 0.35rem;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    background: var(--cream);
    border: 3px solid var(--ink);
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--ink);
  }

  ul a {
    display: block;
    padding: 0.4em 0.9em;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
  }

  ul a:hover,
  ul a[aria-current='page'] {
    background: var(--hot);
  }

  @media (max-width: 480px) {
    .nav__logo {
      width: 52px;
      height: 52px;
    }

    ul a {
      padding: 0.35em 0.65em;
      font-size: 0.95rem;
    }
  }

</style>
