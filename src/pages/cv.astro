---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Star from '../components/Star.astro';

const cv = await getEntry('pages', 'cv');
if (!cv) throw new Error('Missing src/content/pages/cv.md');
const { Content } = await render(cv);
---

<Base title="CV">
  <section class="page">
    <div class="wrap">
      <div class="card" data-reveal>
        <Star size={60} color="var(--sun)" class="card__star" />
        <h1>CV</h1>
        {
          cv.data.cvPdf && (
            <a class="btn btn--pink" href={cv.data.cvPdf} download>
              Download PDF ↓
            </a>
          )
        }
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page {
    min-height: 100svh;
    padding: 9rem 0 6rem;
    background:
      radial-gradient(circle at 15% 20%, rgba(255, 95, 162, 0.25), transparent 40%),
      radial-gradient(circle at 90% 80%, rgba(126, 217, 87, 0.3), transparent 40%),
      var(--cream);
  }

  .card {
    position: relative;
    max-width: 820px;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    background: #fff;
    border: 3px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 8px 8px 0 var(--ink);
  }

  :global(.card__star) {
    position: absolute;
    top: -28px;
    right: 24px;
    animation: c-spin 10s linear infinite;
  }

  h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1;
  }

  .prose :global(h2) {
    display: inline-block;
    margin: 2.25rem 0 0.5rem;
    padding: 0.1em 0.5em;
    background: var(--sun);
    border: 2px solid var(--ink);
    border-radius: 8px;
    font-size: 1.4rem;
    rotate: -1deg;
  }

  .prose :global(li) {
    margin-block: 0.35rem;
  }

  @keyframes c-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
